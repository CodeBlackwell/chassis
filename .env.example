# CHASSIS environment — every variable the design will eventually read.
# Nothing here is wired up yet (skeleton pass); names exist so a provided
# key has one obvious home.

# --- LLM providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434

# --- stack selection ---
# CHASSIS_PROFILE picks a named stack from config/profiles/*.yaml.
CHASSIS_PROFILE=qdrant-local
# Per-layer overrides beat the profile (the live-pivot mechanism).
# e.g. flip the whole system to local Ollama if a cloud key dies mid-demo:
CHASSIS_LLM_IMPL=
CHASSIS_EMBEDDER_IMPL=
CHASSIS_VECTORSTORE_IMPL=

# --- vector store ---
QDRANT_URL=http://localhost:6333
